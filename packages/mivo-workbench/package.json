{
  "name": "mivo-workbench",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "dsh-tauri",
        "dsh-tauri-ui"
      ],
      "external": [
        "dsh-tauri/client",
        "dsh-tauri-ui/client"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "dsh-tauri": "workspace:*",
    "dsh-tauri-ui": "workspace:*",
    "mivo-memory": "workspace:*",
    "react": "catalog:runtime"
  },
  "devDependencies": {
    "tsdown": "catalog:cli"
  },
  "author": "邴越",
  "homepage": "https://FDEChina.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingyue/mivo.git",
    "directory": "packages/mivo-workbench"
  }
}
